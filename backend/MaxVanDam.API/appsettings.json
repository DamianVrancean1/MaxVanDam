{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MaxVanDam.Security": "Information"
    }
  },
  "AllowedHosts": "*",

  "RateLimiting": {
    "Login": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  },

  "ForwardedHeaders": {
    "TrustAllProxies": true,
    "TrustedProxies": []
  }
}
